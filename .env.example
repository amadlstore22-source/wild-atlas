# Copy the vars you need into .env.local (which is gitignored). Leave any you
# don't have yet blank — the site degrades gracefully when they're empty.

# --- Email (contact + newsletter forms) ---
RESEND_API_KEY=

# --- PayPal.Me handle that receives deposits (no @, just the handle) ---
NEXT_PUBLIC_PAYPAL_USERNAME=

# --- Analytics & Google Ads conversion tracking ---
# GA4 Measurement ID. Until this is set, NO analytics/gtag loads at all.
# Find it in Google Analytics → Admin → Data streams → your web stream.
NEXT_PUBLIC_GA_ID=

# Google Ads conversion "send_to" strings, one per conversion action.
# Format: "AW-1234567890/AbCdEfGhIjKlMnOp" (Conversion ID / Conversion label).
# Create the actions in Google Ads → Goals → Conversions, then paste here.
# These are OPTIONAL — GA4 events fire without them; these route the Ads
# conversion so the campaign can optimise bidding.
NEXT_PUBLIC_ADS_SEND_TO_ENQUIRY=
NEXT_PUBLIC_ADS_SEND_TO_WHATSAPP=
NEXT_PUBLIC_ADS_SEND_TO_PHONE=
NEXT_PUBLIC_ADS_SEND_TO_DEPOSIT=
