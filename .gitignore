# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Google Indexing API service-account credentials — NEVER commit
service-account.json
service-account*.json
*-service-account.json
gcp-*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local indexing-quota ledger; machine-specific, not shared state.
docs/.submitted-today.json

# Document ledger: customer names, emails and amounts, plus the invoice and
# contract numbering. Local only — it must never reach a git remote, public or
# private. LOSING IT RESTARTS NUMBERING, which is how two clients were once
# issued the same reference. Keep a backup outside the repo; it is small.
data/documents.json
data/invoices.json

# Booking files: a real client's name, email, dates and price. Same reasoning
# as the ledger above — customer data never goes to a git remote. The example
# in bookings/EXAMPLE.json is committed instead, with invented details.
bookings/*.json
!bookings/EXAMPLE.json

# Client enquiry archive: real names, email addresses and negotiated prices,
# transcribed from the inbox. Same reasoning as the ledger above - customer
# data never reaches a git remote. The patterns learned from it are written up
# without personal details in docs/QUOTING-PATTERNS.md, which IS committed.
data/client-archive.json

# Backups and scratch copies of the above. The named files were ignored but
# their .bak twins were NOT: writing data/client-archive.json.bak before an
# edit left eight real customer names and email addresses staged-able by a
# plain `git add .`. Ignore the whole directory by default and re-admit only
# what is meant to be shared, so a new file in data/ is private unless somebody
# decides otherwise.
data/*
!data/.gitkeep
!data/README.md
